# Frontend server-side telemetry configuration (safe local defaults)
BIB_HARDWARE_CONNECTIONS_ENABLED=false
BIB_TELEMETRY_PROVIDER=http
BIB_API_BASE_URL=http://127.0.0.1:8000
BIB_HUMAN_AUTH_ENABLED=false
# Required on both frontend and backend only when human auth is enabled.
# These are server-side publishable Auth configuration values, not secrets.
# BIB_SUPABASE_URL=https://project-ref.supabase.co
# BIB_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Backend persistence configuration (safe local defaults)
BIB_BACKEND_TELEMETRY_PROVIDER=database
BIB_DATABASE_URL=sqlite:///./bib-platform-dev.db
# Hosting platforms may provide DATABASE_URL instead.
# PostgreSQL placeholders only; never commit a real database URL or password.
# BIB_DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
# BIB_DATABASE_SSLMODE=require

# Backend development ingestion (not authentication)
BIB_INGESTION_ENABLED=false
