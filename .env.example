# Frontend server-side telemetry configuration (safe local defaults)
BIB_TELEMETRY_PROVIDER=http
BIB_API_BASE_URL=http://127.0.0.1:8000

# Backend persistence configuration (safe local defaults)
BIB_BACKEND_TELEMETRY_PROVIDER=database
BIB_DATABASE_URL=sqlite:///./bib-platform-dev.db

# Backend development ingestion (not authentication)
BIB_INGESTION_ENABLED=false
